        <div style="display:inline-block;padding:14px 22px;background:#101a10;border:1px solid #78b864;font-size:28px;letter-spacing:6px;color:#b8f0a4">{{ .RecoveryCode }}</div>
      </td></tr>
          <tr><td style="font-size:12px;line-height:1.7;color:#5b8c4c;padding-bottom:28px;border-top:1px solid #182b16;padding-top:16px">Account recovery. Enter this code on the recovery page. It expires in {{ .ExpiresInMinutes }} minutes. If this was not you, do nothing.</td></tr>
        </table>
      </td></tr>
      <tr><td style="padding:14px 28px;border-top:1px solid #243624;font-size:11px;color:#5b8c4c">[ SECURE BY DESIGN ] · auth.bulbashenko.com</td></tr>
