{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard"],
  "description": "Version bumps arrive as pull requests; the `test` workflow (full stack, end to end) gates the merge.",
  "timezone": "Europe/Bratislava",
  "labels": ["dependencies"],
  "vulnerabilityAlerts": { "enabled": true, "labels": ["security"] },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "Kratos, Hydra, Keto and Oathkeeper ship together under one version: upgrade them together, at once.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["oryd/kratos", "oryd/hydra", "oryd/keto", "oryd/oathkeeper"],
      "groupName": "Ory",
      "schedule": ["at any time"]
    },
    {
      "description": "@ory/client-fetch follows the server versions.",
      "matchPackageNames": ["@ory/client-fetch"],
      "groupName": "Ory"
    },
    {
      "description": "Test-only images and tools: batched weekly.",
      "matchFileNames": ["e2e/**"],
      "groupName": "e2e tooling",
      "schedule": ["before 6am on monday"]
    },
    {
      "description": "Next.js and React together.",
      "matchPackageNames": ["next", "react", "react-dom", "@types/react", "@types/react-dom"],
      "groupName": "Next.js"
    }
  ]
}
