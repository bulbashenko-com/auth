# Fixed, non-secret values for the local and CI test stack only.
AUTH_HOST=auth.bulbashenko.test
POSTGRES_HOST=postgres
KRATOS_DB_PASSWORD=test
HYDRA_DB_PASSWORD=test
KETO_DB_PASSWORD=test
KRATOS_CIPHER_SECRET=0123456789abcdef0123456789abcdef
SERVICE_PASSWORD_64_KRATOSCOOKIE=test-kratos-cookie-secret-0123456789
SERVICE_PASSWORD_64_KRATOSDEFAULT=test-kratos-default-secret-0123456789
SERVICE_PASSWORD_64_KRATOSPAGINATION=test-kratos-pagination-secret-0123456789
SERVICE_PASSWORD_64_HYDRASYSTEM=test-hydra-system-secret-0123456789
SERVICE_PASSWORD_64_HYDRACOOKIE=test-hydra-cookie-secret-0123456789
SERVICE_PASSWORD_64_HYDRAPAGINATION=test-hydra-pagination-secret-0123456789
SMTP_CONNECTION_URI=smtp://mailpit:1025/?disable_starttls=true
SMTP_SENDER=noreply@bulbashenko.test
OIDC_SITE_CLIENT_SECRET=test-site-secret
OIDC_HEADSCALE_CLIENT_SECRET=test-headscale-secret
OIDC_FLUXWEB_CLIENT_SECRET=test-fluxweb-secret
OIDC_GRAFANA_CLIENT_SECRET=test-grafana-secret
# The suite signs in many times a minute from one machine; the rate-limit test checks the per-client limit.
AUTH_RATE_LIMIT_PER_CLIENT=60
AUTH_RATE_LIMIT_TOTAL=1000
