# The only service on the shared `coolify` network: forwards Postgres to the Ory services, which stay on the stack's
# own network so nothing else on the server can reach their unauthenticated admin APIs.
worker_processes 1;
error_log stderr warn;
pid /tmp/nginx.pid;

events { worker_connections 256; }

# Rendered by the image's envsubst step (NGINX_ENVSUBST_OUTPUT_DIR=/etc/nginx). The target is a variable so it is
# resolved per connection and a recreated Postgres container is found again.
stream {
    resolver 127.0.0.11 valid=10s ipv6=off;
    map "" $postgres {
        default ${POSTGRES_HOST}:5432;
    }
    server {
        listen 5432;
        proxy_connect_timeout 5s;
        proxy_pass $postgres;
    }
}
